# ===========================
# IP-SAKTI Sahayak .gitignore
# ===========================

# --- Python / Backend ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
backend/lib/
!frontend/lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.env
.venv
venv/
ENV/
env.bak/
venv.bak/

# FastAPI / SQLite
backend/*.db
backend/*.db-journal
backend/ip_sakti.db

# Chroma vector DB (large, regenerated by ingest script)
backend/data/chroma_db/

# Raw PDFs (add your own — not committed)
backend/data/samples/
!backend/data/samples/.gitkeep

# Sentence-transformers model cache
backend/.model_cache/

# --- Next.js / Frontend ---
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.vercel
frontend/*.tsbuildinfo
frontend/next-env.d.ts

# --- OS / Editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# --- Secrets ---
.env
.env.local
.env.*.local
