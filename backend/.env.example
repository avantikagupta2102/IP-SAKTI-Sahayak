# ============================================================
# IP-SAKTI Sahayak — Backend Environment Variables
# ============================================================

# ---- LLM Provider -------------------------------------------
# Set to "ollama" for 100% local offline AI, or "anthropic" for cloud API
LLM_PROVIDER=ollama

# ---- Ollama Settings (Local Models) --------------------------
# Base URL where Ollama is running
OLLAMA_BASE_URL=http://localhost:11434

# Recommended local models: llama3.2, mistral, qwen2.5:7b, phi3
OLLAMA_MODEL=llama3.2

# Timeout for local LLM generation (seconds)
OLLAMA_TIMEOUT_SECONDS=120.0

# ---- Anthropic Settings (Optional Cloud Fallback) ------------
# Only needed if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# ---- Vector Store & Local Embeddings (FastEmbed ONNX) --------
# Runs 100% locally and offline
EMBED_MODEL=BAAI/bge-small-en-v1.5
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION=ip_sakti_kb

# ---- SQLite Database -----------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./ip_sakti.db

# ---- CORS ----------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Retrieval & Confidence Parameters -----------------------
RETRIEVAL_TOP_K=6
SIMILARITY_THRESHOLD_HIGH=0.75
MAX_UPLOAD_SIZE_BYTES=20971520
SUPPORTED_LANGUAGES=en,hi,ta
