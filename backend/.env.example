# ============================================================
# IP-SAKTI Sahayak — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ---- Required -----------------------------------------------
# Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ---- Optional (defaults shown) ------------------------------

# Claude model to use for generation
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Sentence-transformers embedding model (multilingual, free, local)
EMBED_MODEL=paraphrase-multilingual-mpnet-base-v2

# Directory where Chroma will persist its vector data
CHROMA_PERSIST_DIR=./data/chroma_db

# Name of the Chroma collection
CHROMA_COLLECTION=ip_sakti_kb

# SQLite database URL (async driver)
DATABASE_URL=sqlite+aiosqlite:///./ip_sakti.db

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Maximum number of chunks to retrieve per query
RETRIEVAL_TOP_K=6

# Similarity score threshold (0–1) above which a chunk is "highly relevant"
SIMILARITY_THRESHOLD_HIGH=0.75

# Max upload size in bytes (default 20 MB)
MAX_UPLOAD_SIZE_BYTES=20971520

# Set to "true" to enable the second verification LLM call (doubles latency)
ENABLE_VERIFICATION_CALL=false

# Comma-separated supported language codes for translation
SUPPORTED_LANGUAGES=en,hi,ta
